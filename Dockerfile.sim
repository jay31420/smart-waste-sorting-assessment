# Small multi-architecture image for the hardware-free lower-controller simulator.
ARG PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim-bookworm
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONUNBUFFERED=1
WORKDIR /workspace
COPY simulator /workspace/simulator

EXPOSE 9000
CMD ["python3", "-m", "simulator.lower_simulator", "--host", "0.0.0.0", "--port", "9000"]
